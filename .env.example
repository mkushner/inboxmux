# Public hostname; Caddy obtains a TLS certificate for it. PUBLIC_URL is derived from it in docker-compose.yml.
INBOXMUX_DOMAIN=mail-mcp.example.com

# 32 random bytes, base64. Generate with: docker compose run --rm inboxmux node dist/cli.js gen-key
# Rotation: prepend a new key ("k2:NEW,k1:OLD"), restart, run `inboxmux rotate-key`, then drop the old key.
INBOXMUX_ENCRYPTION_KEY=k1:REPLACE_ME

# Google accounts allowed to sign in (comma-separated).
OWNER_EMAILS=you@example.com

# Google OAuth client (Web application). Used for owner sign-in and Gmail accounts.
# Authorized redirect URI: https://<INBOXMUX_DOMAIN>/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: only MCP clients whose redirect URIs are on these origins may connect (loopback matches any port).
# For Claude: https://claude.ai,https://claude.com   Add http://localhost for local clients such as Claude Code.
ALLOWED_REDIRECT_ORIGINS=

# Optional: Microsoft Entra app for Microsoft 365 / Outlook.com accounts.
# Redirect URI (Web): https://<INBOXMUX_DOMAIN>/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
